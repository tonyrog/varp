//
// All elements must be squre numbers
// run --carry=false --borrow=false
// 


(A:sz == _A11:((sz+1)/2)*_A11:((sz+1)/2)) &&
// (B:sz == _A12:((sz+1)/2)*_A12:((sz+1)/2)) &&
(C:sz == _A13:((sz+1)/2)*_A13:((sz+1)/2)) &&

// (D:sz == _A21:((sz+1)/2)*_A21:((sz+1)/2)) &&
(E:sz == _A22:((sz+1)/2)*_A22:((sz+1)/2)) &&
// (F:sz == _A23:((sz+1)/2)*_A23:((sz+1)/2)) &&

(G:sz == _A31:((sz+1)/2)*_A31:((sz+1)/2)) &&
// (H:sz == _A32:((sz+1)/2)*_A32:((sz+1)/2)) &&
(I:sz == _A33:((sz+1)/2)*_A33:((sz+1)/2)) &&

//
// Limit to magic square params
//   E+k   E-k-m E+m
//   E-k+m E     E+k-m
//   E-m   E+k+m E-k
//

(_P:sz == _K:sz + _M:sz) &&
(_Q:sz == _K:sz - _M:sz) &&
(A:sz == E:sz+_K:sz) && (B:sz == E:sz-_P:sz) && (C:sz == E:sz+_M:sz) &&
(D:sz == E:sz-_Q:sz) && (F:sz == E:sz+_Q:sz) &&
(G:sz == E:sz-_M:sz) && (H:sz == E:sz+_P:sz) && (I:sz == E:sz-_K:sz) &&

//
// All elements must be distinct
//
(_M:sz > 0) && (_M:sz < E:sz) &&
(_K:sz > 0) && (_K:sz < E:sz) &&
(_K:sz != _M:sz) &&
(_K:sz != _M:sz+_M:sz) &&
(_M:sz != _K:sz+_K:sz) &&
// debug
(K:sz == _K:sz) &&
(M:sz == _M:sz) &&

// output sum in the model
(S:sz == 3 * E:sz) && 

true

