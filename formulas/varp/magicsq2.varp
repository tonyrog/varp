//
// All elements must be squre numbers
// run --carry=false --borrow=false
// 
declare A:sz, B:sz, C:sz, D:sz, E:sz, F:sz, G:sz, H:sz, I:sz;
declare _P:sz, _Q:sz, _K:sz, _M:sz, S:sz;
declare _A11:((sz+1)/2);
declare _A12:((sz+1)/2);
declare _A13:((sz+1)/2);
declare _A21:((sz+1)/2);
declare _A22:((sz+1)/2);
declare _A23:((sz+1)/2);
declare _A31:((sz+1)/2);
declare _A32:((sz+1)/2);
declare _A33:((sz+1)/2);

(A == _A11*_A11) &&
(B == _A12*_A12) &&
(C == _A13*_A13) &&

(D == _A21*_A21) &&
(E == _A22*_A22) &&
(F == _A23*_A23) &&

(G == _A31*_A31) &&
(H == _A32*_A32) &&
(I == _A33*_A33) &&

//
// Limit to magic square params
//   E+k   E-k-m E+m
//   E-k+m E     E+k-m
//   E-m   E+k+m E-k
//

(_P == _K + _M) &&
(_Q == _K - _M) &&
(A == E+_K) && (B == E-_P) && (C == E+_M) &&
(D == E-_Q) &&                (F == E+_Q) &&
(G == E-_M) && (H == E_+P) && (I == E-_K) &&

//
// All elements must be distinct
//
(_M > 0) && (_M < E) &&
(_K > 0) && (_K < E) &&
(_K != _M) &&
(_K != _M+_M) &&
(_M != _K+_K) &&
// debug
//(K == _K) &&
//(M == _M) &&

// output sum in the model
(S == 3 * E) && 

true

