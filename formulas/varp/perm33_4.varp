// Superpermutaton av längd 33 för 4 element
// (den minsta längd som ska funka) är också ett kul testexempel:
[A x=1..33][E! y=1..4] P(x,y) &&
[E x=1..30] (P(x,1) && P(x+1,2) && P(x+2,3) && P(x+3,4)) &&
[E x=1..30] (P(x,1) && P(x+1,2) && P(x+2,4) && P(x+3,3)) &&
[E x=1..30] (P(x,1) && P(x+1,3) && P(x+2,2) && P(x+3,4)) &&
[E x=1..30] (P(x,1) && P(x+1,3) && P(x+2,4) && P(x+3,2)) &&
[E x=1..30] (P(x,1) && P(x+1,4) && P(x+2,2) && P(x+3,3)) &&
[E x=1..30] (P(x,1) && P(x+1,4) && P(x+2,3) && P(x+3,2)) &&
[E x=1..30] (P(x,2) && P(x+1,1) && P(x+2,3) && P(x+3,4)) &&
[E x=1..30] (P(x,2) && P(x+1,1) && P(x+2,4) && P(x+3,3)) &&
[E x=1..30] (P(x,2) && P(x+1,3) && P(x+2,1) && P(x+3,4)) &&
[E x=1..30] (P(x,2) && P(x+1,3) && P(x+2,4) && P(x+3,1)) &&
[E x=1..30] (P(x,2) && P(x+1,4) && P(x+2,1) && P(x+3,3)) &&
[E x=1..30] (P(x,2) && P(x+1,4) && P(x+2,3) && P(x+3,1)) &&
[E x=1..30] (P(x,3) && P(x+1,2) && P(x+2,1) && P(x+3,4)) &&
[E x=1..30] (P(x,3) && P(x+1,2) && P(x+2,4) && P(x+3,1)) &&
[E x=1..30] (P(x,3) && P(x+1,1) && P(x+2,2) && P(x+3,4)) &&
[E x=1..30] (P(x,3) && P(x+1,1) && P(x+2,4) && P(x+3,2)) &&
[E x=1..30] (P(x,3) && P(x+1,4) && P(x+2,2) && P(x+3,1)) &&
[E x=1..30] (P(x,3) && P(x+1,4) && P(x+2,1) && P(x+3,2)) &&
[E x=1..30] (P(x,4) && P(x+1,1) && P(x+2,3) && P(x+3,2)) &&
[E x=1..30] (P(x,4) && P(x+1,1) && P(x+2,2) && P(x+3,3)) &&
[E x=1..30] (P(x,4) && P(x+1,3) && P(x+2,1) && P(x+3,2)) &&
[E x=1..30] (P(x,4) && P(x+1,3) && P(x+2,2) && P(x+3,1)) &&
[E x=1..30] (P(x,4) && P(x+1,2) && P(x+2,1) && P(x+3,3)) &&
[E x=1..30] (P(x,4) && P(x+1,2) && P(x+2,3) && P(x+3,1)) &&

// instansiate & add invariants
P(1,1) && P(2,2) && P(3,3) && P(4,4) &&
[A x=1..32][A y=1..4](not P(x,y) or not P(x+1,y)) &&
[A x=1..30][A y=2..4][LTE 1](P(x,y),P(x+1,y),P(x+2,y)) &&
[A x=1..28][A y=1..4][GTE 1](P(x,y),P(x+1,y),P(x+2,y),P(x+3,y),P(x+4,y),P(x+5,y))

