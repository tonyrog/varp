// +   +===+===+===+   +       +===+
// | 1   1 | 7 |   | 2 | 4   4 | 5 |
// +===+===+   +===+===+===+===+   +
// | 6 | 7   7 |   |   | 5   5   5 |
// +   +===+   +===+===+===+===+   +
// | 6   6 | 7 | 8   8 | A   A | 5 |
// +===+   +   +===+   +===+   +===+
// | C | 6 | 7 | 9 | 8   8 | A   A |
// +   +   +===+   +===+   +   +===+
// | C | 6 | 9   9   9 | 8 | A | B |
// +   +===+===+   +===+===+===+   +
// | C   C   C | 9 | B   B   B   B |
// +===+===+===+===+===+===+===+===+
//

// If block n in orientation m and position p is true then
// it the block B(n,m,p) occupies S(n,i,j)
// adding a restriction that exactly ONE of the definitions
// must be TRUE

// Add a rule that only one block n may occupy a single square

