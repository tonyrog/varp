
declare C(i,j):11/signed;
declare SA(i):7/signed;
declare SB(i):7/signed;

declare CAP1(i):1;
declare CAN1(i):1;
declare CAP2(i):1;
declare CAN2(i):1;
declare CBP1(i):1;
declare CBN1(i):1;
declare CBP2(i):1;
declare CBN2(i):1;

define A(1,1) 3;
define A(1,2) 5;
define A(2,1) 7;
define A(2,2) 11;
define B(1,1) 13;
define B(1,2) 17;
define B(2,1) 19;
define B(2,2) 23;

(C(1,1) == (A(1,1)*B(1,1) + A(1,2)*B(2,1))) &&
(C(1,2) == (A(1,1)*B(1,2) + A(1,2)*B(2,2))) &&
(C(2,1) == (A(2,1)*B(1,1) + A(2,2)*B(2,1))) &&
(C(2,2) == (A(2,1)*B(1,2) + A(2,2)*B(2,2))) &&

// strassen coefficients (regular setup)

((CAP1(1) == 1) && (CAN1(1) == 0) && (CAP2(1) == 1) && (CAN2(1) == 0)) &&  // SA(1) = A(1,1) + A(1,2)
((CAP1(2) == 1) && (CAN1(2) == 0) && (CAP2(2) == 1) && (CAN2(2) == 0)) &&  // SA(2) = A(1,1) + A(2,2)
((CAP1(3) == 0) && (CAN1(3) == 1) && (CAP2(3) == 1) && (CAN2(3) == 0)) &&  // SA(3) = A(2,1)  -A(1,1)
((CAP1(4) == 1) && (CAN1(4) == 0) && (CAP2(4) == 0) && (CAN2(4) == 1)) &&  // SA(4) = A(1,2)  -A(2,2)
((CAP1(5) == 0) && (CAN1(5) == 0) && (CAP2(5) == 0) && (CAN2(5) == 0)) &&  // SA(5) = 0
((CAP1(6) == 1) && (CAN1(6) == 0) && (CAP2(6) == 1) && (CAN2(6) == 0)) &&  // SA(6) = A(2,1) + A(2,2)
((CAP1(7) == 1) && (CAN1(7) == 0)) &&                                      // SA(7) = A(1,1)
((CAP1(8) == 1) && (CAN1(8) == 0)) &&                                      // SA(8) = A(2,2)

((CBP1(1) == 1) && (CBN1(1) == 0) && (CBP2(1) == 1) && (CBN2(1) == 0)) &&  // SB(1) = B(1,1) + B(1,2)
((CBP1(2) == 1) && (CBN1(2) == 0) && (CBP2(2) == 1) && (CBN2(2) == 0)) &&  // SB(2) = B(1,1) + B(2,2)
((CBP1(3) == 0) && (CBN1(3) == 1) && (CBP2(3) == 1) && (CBN2(3) == 0)) &&  // SB(3) = B(2,1)  -B(1,1)
((CBP1(4) == 1) && (CBN1(4) == 0) && (CBP2(4) == 0) && (CBN2(4) == 1)) &&  // SB(4) = B(1,2)  -B(2,2)
((CBP1(5) == 0) && (CBN1(5) == 0) && (CBP2(5) == 0) && (CBN2(5) == 0)) &&  // SB(5) = 0
((CBP1(6) == 1) && (CBN1(6) == 0) && (CBP2(6) == 1) && (CBN2(6) == 0)) &&  // SB(6) = B(2,1) + B(2,2)
((CBP1(7) == 1) && (CBN1(7) == 0)) &&                                      // SB(7) = B(1,1)
((CBP1(8) == 1) && (CBN1(8) == 0)) &&                                      // SB(8) = B(2,2)

// AHEAD
// define possible products between sums of A's and B's (columns and diagonal)


(SA(1)  == (CAP1(1)*A(1,1)-CAN1(1)*A(1,1)+CAP2(1)*A(1,2)-CAN2(1)*A(1,2))) &&  // ROW1
(SA(2)  == (CAP1(2)*A(1,1)-CAN1(2)*A(1,1)+CAP2(2)*A(2,2)-CAN2(2)*A(2,2))) &&  // DIAG1
(SA(3)  == (CAP1(3)*A(1,1)-CAN1(3)*A(1,1)+CAP2(3)*A(2,1)-CAN2(3)*A(2,1))) &&  // COL1
(SA(4)  == (CAP1(4)*A(1,2)-CAN1(4)*A(1,2)+CAP2(4)*A(2,2)-CAN2(4)*A(2,2))) &&  // COL2
(SA(5)  == (CAP1(5)*A(1,2)-CAN1(5)*A(1,2)+CAP2(5)*A(2,1)-CAN2(5)*A(2,1))) &&  // DIAG2
(SA(6)  == (CAP1(6)*A(2,1)-CAN1(6)*A(2,1)+CAP2(6)*A(2,2)-CAN2(6)*A(2,2))) &&  // ROW2
(SA(7)  == (CAP1(7)*A(1,1)-CAN1(7)*A(1,1)))                               &&  // ELEM(1,1)
(SA(8)  == (CAP1(8)*A(2,2)-CAN1(8)*A(2,2)))                               &&  // ELEM(2,2)

(SB(1)  == (CBP1(1)*B(1,1)-CBN1(1)*B(1,1)+CBP2(1)*B(1,2)-CBN2(1)*B(1,2))) &&  // ROW1
(SB(2)  == (CBP1(2)*B(1,1)-CBN1(2)*B(1,1)+CBP2(2)*B(2,2)-CBN2(2)*B(2,2))) &&   // DIAG1
(SB(3)  == (CBP1(3)*B(1,1)-CBN1(3)*B(1,1)+CBP2(3)*B(2,1)-CBN2(3)*B(2,1))) &&  // COL1
(SB(4)  == (CBP1(4)*B(1,2)-CBN1(4)*B(1,2)+CBP2(4)*B(2,2)-CBN2(4)*B(2,2))) &&  // COL2
(SB(5)  == (CBP1(5)*B(1,2)-CBN1(5)*B(1,2)+CBP2(5)*B(2,1)-CBN2(5)*B(2,1))) &&  // DIAG2
(SB(6)  == (CBP1(6)*B(2,1)-CBN1(6)*B(2,1)+CBP2(6)*B(2,2)-CBN2(6)*B(2,2))) &&  // ROW2
(SB(7)  == (CBP1(7)*B(1,1)-CBN1(7)*B(1,1)))                               &&  // ELEM(1,1)
(SB(8)  == (CBP1(8)*B(2,2)-CBN1(8)*B(2,2)))                                   // ELEM(2,2)
