//
//  Towers of hanoi boolean version
//  number of pegs, number of discs
//
//  encoding
//               peg   pos 
//        Tower(   1,   1,  time) : Bits
//
//          top ...  bottom (stack)
//  peg pos   1   2   3
//  --------------------
//  1         1   2   3
//  2         0   0   0
//  3         0   0   0
//
// Move(1,2)
//  peg pos   1   2    3
//  --------------------
//  1         2   3    0
//  2         1   0    0
//  3         0   0    0
//

system hanoi {
       state Tower(p,y,time):(usize(n+1));   // disc size 0, 1, .. n
       init  [A y=1..n] (Tower(1, y) == y); // all discs on tower 1
       init  [A p=2..n,y=1..n] (Tower(p, y) == 0); // the others are empty
       input Move(p,q,time);
       assume [E! p=1..3,q=1..3,p!=q] Move(p,q);

       next Move(1,2) ->
             ( (Tower(1,1) > 0) && (Tower(2,n) == 0)            &&
	       ((Tower(2,1) == 0) || (Tower(1,1) < Tower(2,1))) &&
	       ([A i=1..n-1] ('Tower(1,i) == Tower(1,i+1)))     &&
	       ([A i=2..n] ('Tower(2,i) == Tower(2,i-1)))       &&
	       ([A i=1..n] ('Tower(3,i) == Tower(3,i)))         &&	     
	       ('Tower(1,n) == 0) &&
	       ('Tower(2,1) == Tower(1,1)));

       next Move(1,3) ->
            ( (Tower(1,1) > 0) && (Tower(3,n) == 0) &&
	      ((Tower(3,1) == 0) || (Tower(1,1) < Tower(3,1))) &&
	      ([A i=1..n-1] ('Tower(1,i) == Tower(1,i+1)))     &&
	      ([A i=2..n] ('Tower(3,i) == Tower(3,i-1)))       &&
	      ([A i=1..n] ('Tower(2,i) == Tower(2,i)))         &&
	      ('Tower(1,n) == 0) &&
	      ('Tower(3,1) == Tower(1,1)));

       next Move(2,1) ->
             ( (Tower(2,1) > 0) && (Tower(1,n) == 0)             &&
     	       ((Tower(1,1) == 0) || (Tower(2,1) < Tower(1,1)))  &&	    
	       ([A i=1..n-1] ('Tower(2,i) == Tower(2,i+1)))      &&
	       ([A i=2..n] ('Tower(1,i) == Tower(1,i-1)))        &&
	       ([A i=1..n] ('Tower(3,i) == Tower(3,i)))          &&
	       ('Tower(2,n) == 0) &&
	       ('Tower(1,1) == Tower(2,1)));
	     
       next Move(2,3) ->
             ( (Tower(2,1) > 0) && (Tower(3,n) == 0) &&
  	       ((Tower(3,1) == 0) || (Tower(2,1) < Tower(3,1))) &&	    
	       ([A i=1..n-1] ('Tower(2,i) == Tower(2,i+1))) &&
	       ([A i=2..n] ('Tower(3,i) == Tower(3,i-1)))   &&
	       ([A i=1..n] ('Tower(1,i) == Tower(1,i)))     &&	       
	       ('Tower(2,n) == 0) &&
	       ('Tower(3,1) == Tower(2,1)));

       next Move(3,1) ->
             ( (Tower(3,1) > 0) && (Tower(1,n) == 0) &&
  	       ((Tower(1,1) == 0) || (Tower(3,1) < Tower(1,1))) &&
	       ([A i=1..n-1] ('Tower(3,i) == Tower(3,i+1))) &&
	       ([A i=2..n] ('Tower(1,i) == Tower(1,i-1)))   &&
	       ([A i=1..n] ('Tower(2,i) == Tower(2,i)))     &&	       	       
	       ('Tower(3,n) == 0) &&
	       ('Tower(1,1) == Tower(3,1)));
	     
       next Move(3,2) ->
             ( (Tower(3,1) > 0) && (Tower(2,n) == 0) &&
	       ([A i=1..n-1] ('Tower(3,i) == Tower(3,i+1))) &&
  	       ((Tower(2,1) == 0) || (Tower(3,1) < Tower(2,1))) &&	       
	       ([A i=2..n] ('Tower(2,i) == Tower(2,i-1)))   &&
	       ([A i=1..n] ('Tower(1,i) == Tower(1,i)))     &&
	       ('Tower(3,n) == 0) &&
	       ('Tower(2,1) == Tower(3,1)));

       reach  [A y=1..n] (Tower(3, y) == y); // all discs on tower 3
}

// hanoi_init(0) && hanoi_next(1)
