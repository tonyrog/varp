//
//  | A(0,0)  A(0,1)  A(0,2) A(0,3)
//  | A(1,0)  A(1,1)  A(1,2) A(1,3)
//  | A(2,0)  A(2,1)  A(2,2) A(2,3)
//  | A(3,0)  A(3,1)  A(3,2) A(3,3)
// 
declare A(i,j):6;
declare S:6;

// (S == 34) &&

// 1 <= A(i,j) <= 16
([A i=0..3, j=0..3] (A(i,j) >= 1))  &&
([A i=0..3, j=0..3] (A(i,j) <= 16)) && 

// Distinct elements
([A k=0..14][A l=(k+1)..15] (A(k/4,k%4) != A(l/4,l%4))) &&

// Row sums
([A i=0..3] (S == A(i,0)+A(i,1)+A(i,2)+A(i,3))) &&

// Column sums
([A j=0..3] (S == A(0,j)+A(1,j)+A(2,j)+A(3,j))) &&

// Diagonal sums
(S == A(0,0)+A(1,1)+A(2,2)+A(3,3)) &&
(S == A(0,3)+A(1,2)+A(2,1)+A(3,0)) &&

// 2x2 corners
(S == A(0,0)+A(0,1)+A(1,0)+A(1,1)) &&
(S == A(0,2)+A(0,3)+A(1,2)+A(1,3)) &&
(S == A(2,0)+A(2,1)+A(3,0)+A(3,1)) &&
(S == A(2,2)+A(2,3)+A(3,2)+A(3,3)) &&
// center 2x2
(S == A(1,1)+A(1,2)+A(2,1)+A(2,2))


