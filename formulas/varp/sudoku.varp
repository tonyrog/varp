//
// Boolean encoding of sudoku S(i,j,k)
// S(i,j) = k  number at position i,j is k
//

// puzzle input is process into formula by sudoku_input
// incase of a multi puzzle file 'recno' is set to
// record (line) number, counting from 1.
input sudoku_io;
output sudoku_io;

( [A i=1..9,j=1..9] [E! k=1..9]  S(i,j,k) ) &&
( [A i=1..9,k=1..9] [E! j=1..9]  S(i,j,k) ) &&
( [A j=1..9,k=1..9] [E! i=1..9]  S(i,j,k) ) &&
( [A s=0..2,t=0..2,k=1..9] [E! i=0..8]
   S(3*s+(i/3)+1, 3*t+(i%3)+1, k) )
