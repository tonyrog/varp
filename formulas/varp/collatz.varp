//
//  Each model is a collatz sequence of length n(+1)
//  Bit size must be big enough to represent numbers in
//  the sequence
//

// 

declare A(i):(n+1);

(A(n) == 1) &&
[A i=0..n-1](
(A(i) != 1) &&
(A(i+1) == ( (A(i)[0]*(3*A(i)+1)) + ((1-A(i)[0]) * (A(i) / 2))) )
)

//
// - largest number in a n sequence is 2^n (fit in n+1 bits)
// - A(i) = 2*A(i+1)
// - A(i) = (A(i+1)-1)/3  if A(i+1)-4 == 0 mod 6
//

// n=1
// 1: A(0)=2,A(1)=1
//

// n=2
// 1: A(0)=4,A(1)=2,A(2)=1
//

// n=3
// 1: A(0)=8,A(1)=4,A(2)=2,A(3)=1
//

// n=4
// 1: A(0)=16,A(1)=8,A(2)=4,A(3)=2,A(4)=1
//

// n=5
// 1: A(0)=32,A(1)=16,A(2)=8,A(3)=4,A(4)=2,A(5)=1
// 2: A(0)=5,A(1)=16,A(2)=8,A(3)=4,A(4)=2,A(5)=1
//

// n=6
