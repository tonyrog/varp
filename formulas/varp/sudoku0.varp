
([EQ 81-n,i=1..9,j=1..9] P1(i,j,0)) &&
([A i=1..9,j=1..9] [E! k=0..9] P1(i,j,k) ) &&

([EQ 81-(n-1),i=1..9,j=1..9] P2(i,j,0)) &&
([A i=1..9,j=1..9] [E! k=0..9] P2(i,j,k) ) &&

( [A i=1..9,j=1..9,k=1..9] (P2(i,j,k) -> P1(i,j,k)) ) &&

( [A i=1..9,j=1..9,k=1..9] (P1(i,j,k) -> S1(i,j,k)) ) &&

(( [A i=1..9,j=1..9] [E! k=1..9] S1(i,j,k) ) &&
 ( [A i=1..9,k=1..9] [E! j=1..9] S1(i,j,k) ) &&
 ( [A j=1..9,k=1..9] [E! i=1..9] S1(i,j,k) ) &&
 ( [A s=0..2,t=0..2,k=1..9] [E! i=0..8]
   S1(3*s+(i/3)+1, 3*t+(i%3)+1, k) )) &&

( [A i=1..9,j=1..9,k=1..9] (P2(i,j,k) -> S2(i,j,k)) ) &&

(( [A i=1..9,j=1..9] [E! k=1..9] S2(i,j,k) ) &&
 ( [A i=1..9,k=1..9] [E! j=1..9] S2(i,j,k) ) &&
 ( [A j=1..9,k=1..9] [E! i=1..9] S2(i,j,k) ) &&
 ( [A s=0..2,t=0..2,k=1..9] [E! i=0..8]
   S2(3*s+(i/3)+1, 3*t+(i%3)+1, k) ) )
