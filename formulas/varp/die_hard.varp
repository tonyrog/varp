// 1: B(0)=0,B(1)=5,B(2)=5,B(3)=2,B(4)=2,B(5)=0,B(6)=5,B(7)=4,Big_to_small(3),Big_to_small(5),Big_to_small(7),Empty_small(4),Fill_big(1),Fill_big(2),Fill_big(6),Init(0),L(0)=0,L(1)=0,L(2)=0,L(3)=3,L(4)=0,L(5)=2,L(6)=2,L(7)=3
// 2: B(0)=0,B(1)=5,B(2)=5,B(3)=2,B(4)=2,B(5)=0,B(6)=5,B(7)=4,Big_to_small(3),Big_to_small(5),Big_to_small(7),Empty_small(2),Empty_small(4),Fill_big(1),Fill_big(6),Init(0),L(0)=0,L(1)=0,L(2)=0,L(3)=3,L(4)=0,L(5)=2,L(6)=2,L(7)=3

// SOLUTIONS 8 steps
// 1: B(0)=0,B(1)=0,B(2)=5,B(3)=5,B(4)=2,B(5)=2,B(6)=0,B(7)=5,B(8)=4,Big_to_small(4),Big_to_small(6),Big_to_small(8),Empty_small(3),Empty_small(5),Fill_big(2),Fill_big(7),Fill_small(1),Init(0),L(0)=0,L(1)=3,L(2)=3,L(3)=0,L(4)=3,L(5)=0,L(6)=2,L(7)=2,L(8)=3
// 2: B(0)=0,B(1)=0,B(2)=3,B(3)=5,B(4)=2,B(5)=2,B(6)=0,B(7)=5,B(8)=4,Big_to_small(4),Big_to_small(6),Big_to_small(8),Empty_small(5),Fill_big(3),Fill_big(7),Fill_small(1),Init(0),L(0)=0,L(1)=3,L(2)=0,L(3)=0,L(4)=3,L(5)=0,L(6)=2,L(7)=2,L(8)=3,Small_to_big(2)
