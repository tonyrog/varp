//
//  Square sum a^2+b^2 = c^2+d^2 = e^2+f^2
//

declare A:((sz+1)/2);
declare B:((sz+1)/2);
declare C:((sz+1)/2);
declare D:((sz+1)/2);
declare E:((sz+1)/2);
declare F:((sz+1)/2);
declare A2:sz;
declare B2:sz;
declare C2:sz;
declare D2:sz;
declare E2:sz;
declare F2:sz;
declare Sum:(sz+1);
// set global options
// options carry=false;

(Sum == A2 + B2) &&
(Sum == C2 + D2) &&
(Sum == E2 + F2) &&

(A2 == A*A) &&
(B2 == B*B) &&
(C2 == C*C) &&
(D2 == D*D) &&
(E2 == E*E) &&
(F2 == F*F) &&

(A < B) &&
(C < D) &&
(E < F) &&
(A < C) &&
(C < E) &&

(A > 0) && 
(B > 0) &&
(C > 0) &&
(D > 0) &&
(E > 0) &&
(F > 0)

