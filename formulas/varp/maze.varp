//
// Maze solver/builder
//

input  maze_io;
output maze_io;

define L(s,i,j)  Left(s) and Pos(s,i,j) and !Wall(i,j) and Pos(s-1,i,j+1) ;
define R(s,i,j)  Right(s) and Pos(s,i,j) and !Wall(i,j) and Pos(s-1,i,j-1) ;
define U(s,i,j)  Up(s) and Pos(s,i,j) and !Wall(i,j) and Pos(s-1,i+1,j) ;
define D(s,i,j)  Down(s) and Pos(s,i,j) and !Wall(i,j) and Pos(s-1,i-1,j) ;

define LEFT(s)  [E i=1..n,   j=1..m-1] L(s,i,j) ;
define RIGHT(s) [E i=1..n,   j=2..m]   R(s,i,j) ;
define UP(s)    [E i=1..n-1, j=1..m]   U(s,i,j) ;
define DOWN(s)  [E i=2..n,   j=1..m]   D(s,i,j) ;

define NEXT(s) (LEFT(s) or RIGHT(s) or UP(s) or DOWN(s)) and
               [EQ 1](Left(s),Right(s),Up(s),Down(s)) ;

([A s=0..k] ([E! i=1..n,j=1..m] Pos(s,i,j))) and 
([A s=1..k] NEXT(s))

