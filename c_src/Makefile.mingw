#
# Makefile for Mingw
#
PYTHON = python3

PYTHON_INCLUDE = -I "/c/Program Files/Python38/include"
PYTHON_LDFLAGS = "/c/Program Files/Python38/python38.dll"

ERLDIR	:= $(shell erl -noshell -eval "io:format([126,115,126,110],[code:root_dir()])" -s erlang halt)
ERL_C_INCLUDE_DIR := "$(ERLDIR)/usr/include"
CC = gcc
PRIVDIR=../priv
PYDIR=../py

CFLAGS += -O3
CFLAGS += -D__WIN32__ -DWIN32 -D_MT -D_DLL -DEBUG_MEM -DDLOG_DEFAULT=DLOG_NONE
CFLAGS += -Wall -Wextra -Wswitch-default -Wswitch-enum -D_THREAD_SAFE -D_REENTRANT -fno-common
CFLAGS += $(PYTHON_INCLUDE) -I$(ERL_C_INCLUDE_DIR)

LD_SHARED	:= $(CC) -shared
LIBS = -lkernel32 -luser32 -ladvapi32

debug: CFLAGS += -g
debug: LDFLAGS += -g

VARP_NIF = $(PRIVDIR)/varc_nif.dll
VARP_EXE = $(PRIVDIR)/Varp.exe
VARP_PYD = $(PYDIR)/varp.pyd

VARP_NIF_OBJS = varc_nif.obj

debug release all: $(VARP_NIF) $(VARP_EXE) $(VARP_PYD)

$(VARP_NIF): $(VARP_NIF_OBJS)  xnif_funcs.obj
	$(LD_SHARED) -o $@ $(VARP_NIF_OBJS) xnif_funcs.obj $(LDFLAGS)

$(VARP_PYD): varpy.obj $(VARP_NIF_OBJS)
	$(LD_SHARED) $(PYTHON_LDFLAGS) -o $@ $(VARP_NIF_OBJS) varpy.obj

varpy.obj: $(HOME)/erlang/pynif/c_src/pynif.c
	$(CC) $(CFLAGS) -o$@ -DPYNIFNAME=varp -c $<

$(VARP_EXE): varp.c varp_res.obj
	$(CC) -o $(VARP_EXE) varp.c varp_res.obj -mwindows $(LIBS)

varp_res.obj: varp.rc
	windres -i varp.rc -o varp_res.obj

xnif_funcs.obj:	xnif_funcs.h

%.obj: %.c
	$(CC) -c -o $@ $(CFLAGS) $<
