#
# Make the python/nif wrapper for varc.so
#
# make -f Makefile.varpy
#

# PYTHON = python2
# PYTHON_VERSION = 2.7

PYTHON = python3
PYTHON_VERSION = 3.8

CC = gcc
CC_FLAGS = -fPIC -I/usr/include/python$(PYTHON_VERSION) -Wall -Wextra -Wno-unused-parameter -O2 -g
LD_FLAGS = -shared

PYNAME = varp

varp.so: $(HOME)/erlang/pynif/c_src/pynif.c
	 $(CC) $(LD_FLAGS) $(CC_FLAGS) -o varp.so -DPYNIFNAME=$(PYNAME) varc_nif.o $<
