
([EQ 81-n,i=1..9,j=1..9] S0(i,j,0)) &&

( [FORALL i=1..9,j=1..9,k=1..9] (S0(i,j,k) -> S1(i,j,k)) ) &&

( [FORALL i=1..9,j=1..9] [EXISTS! k=1..9]  S1(i,j,k) ) &&
( [FORALL i=1..9,k=1..9] [EXISTS! j=1..9]  S1(i,j,k) ) &&
( [FORALL j=1..9,k=1..9] [EXISTS! i=1..9]  S1(i,j,k) ) &&
( [FORALL s=0..2,t=0..2,k=1..9] [EXISTS! i=0..8]
   S1(3*s+(i/3)+1, 3*t+(i%3)+1, k) )
