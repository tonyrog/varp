//
// Formulation of strassen
//

// input and output
declare C(i,j):11/signed;
// sums of A's and B's
declare SA(i):7/signed;
declare SB(i):7/signed;

declare CAP1(i):1;
declare CAN1(i):1;
declare CAP2(i):1;
declare CAN2(i):1;
declare CBP1(i):1;
declare CBN1(i):1;
declare CBP2(i):1;
declare CBN2(i):1;

// prodct of element sums 
declare M(i,j):14/signed;
// M selections
declare CM(a,b,i,j):2/signed;

// declare multiplies
// | 2 3 |  | 11 13 |
// | 5 7 |  | 17 19 |

define A(1,1) 3;
define A(1,2) 5;
define A(2,1) 7;
define A(2,2) 11;
define B(1,1) 13;
define B(1,2) 17;
define B(2,1) 19;
define B(2,2) 23;

(C(1,1) == (A(1,1)*B(1,1) + A(1,2)*B(2,1))) &&
(C(1,2) == (A(1,1)*B(1,2) + A(1,2)*B(2,2))) &&
(C(2,1) == (A(2,1)*B(1,1) + A(2,2)*B(2,1))) &&
(C(2,2) == (A(2,1)*B(1,2) + A(2,2)*B(2,2))) &&

(SA(1)  == (CAP1(1)*A(1,1)-CAN1(1)*A(1,1)+CAP2(1)*A(1,2)-CAN2(1)*A(1,2))) &&  // ROW1
(SA(2)  == (CAP1(2)*A(1,1)-CAN1(2)*A(1,1)+CAP2(2)*A(2,2)-CAN2(2)*A(2,2))) &&  // DIAG1
(SA(3)  == (CAP1(3)*A(1,1)-CAN1(3)*A(1,1)+CAP2(3)*A(2,1)-CAN2(3)*A(2,1))) &&  // COL1
(SA(4)  == (CAP1(4)*A(1,2)-CAN1(4)*A(1,2)+CAP2(4)*A(2,2)-CAN2(4)*A(2,2))) &&  // COL2
(SA(5)  == (CAP1(5)*A(1,2)-CAN1(5)*A(1,2)+CAP2(5)*A(2,1)-CAN2(5)*A(2,1))) &&  // DIAG2
(SA(6)  == (CAP1(6)*A(2,1)-CAN1(6)*A(2,1)+CAP2(6)*A(2,2)-CAN2(6)*A(2,2))) &&  // ROW2
(SA(7)  == (CAP1(7)*A(1,1)-CAN1(7)*A(1,1)))                               &&  // ELEM(1,1)
(SA(8)  == (CAP1(8)*A(2,2)-CAN1(8)*A(2,2)))                               &&  // ELEM(2,2)
//(SA(9)  == (CAP1(9)*A(1,2)-CAN1(9)*A(1,2)))                               &&  // ELEM(1,2)
//(SA(10) == (CAP1(10)*A(2,1)-CAN1(10)*A(2,1)))                             &&  // ELEM(2,1)

(SB(1)  == (CBP1(1)*B(1,1)-CBN1(1)*B(1,1)+CBP2(1)*B(1,2)-CBN2(1)*B(1,2))) &&  // ROW1
(SB(2)  == (CBP1(2)*B(1,1)-CBN1(2)*B(1,1)+CBP2(2)*B(2,2)-CBN2(2)*B(2,2))) &&  // DIAG1
(SB(3)  == (CBP1(3)*B(1,1)-CBN1(3)*B(1,1)+CBP2(3)*B(2,1)-CBN2(3)*B(2,1))) &&  // COL1
(SB(4)  == (CBP1(4)*B(1,2)-CBN1(4)*B(1,2)+CBP2(4)*B(2,2)-CBN2(4)*B(2,2))) &&  // COL2
(SB(5)  == (CBP1(5)*B(1,2)-CBN1(5)*B(1,2)+CBP2(5)*B(2,1)-CBN2(5)*B(2,1))) &&  // DIAG2
(SB(6)  == (CBP1(6)*B(2,1)-CBN1(6)*B(2,1)+CBP2(6)*B(2,2)-CBN2(6)*B(2,2))) &&  // ROW2
(SB(7)  == (CBP1(7)*B(1,1)-CBN1(7)*B(1,1)))                               &&  // ELEM(1,1)
(SB(8)  == (CBP1(8)*B(2,2)-CBN1(8)*B(2,2)))                               &&  // ELEM(2,2)
//(SB(9)  == (CBP1(9)*B(1,2)-CBN1(9)*B(1,2)))                             &&  // ELEM(1,2)
//(SB(10) == (CBP1(10)*B(2,1)-CBN1(10)*B(2,1)))                           &&  // ELEM(2,1)

([A i=1..8] !((CAP1(i)==1) && (CAN1(i)==1))) &&
([A i=1..6] !((CAP2(i)==1) && (CAN2(i)==1))) &&
([A i=1..8] !((CBP1(i)==1) && (CBN1(i)==1))) &&
([A i=1..6] !((CBP2(i)==1) && (CBN2(i)==1))) &&

([A i=1..8,j=1..8] (M(i,j) == (SA(i)*SB(j)))) &&

([A a=1..2,b=1..2]
    (C(a,b) == ([SUM i=1..8,j=1..8] (CM(a,b,i,j)*M(i,j))))) &&

([A a=1..2,b=1..2,i=1..8,j=1..8] (CM(a,b,i,j) != -2)) &&

([A a=1..2,b=1..2]([LTE 4,i=1..8,j=1..8](CM(a,b,i,j) != 0))) &&

([EQ 7,i=1..8,j=1..8](M(i,j) != 0))


