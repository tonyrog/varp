//
// Factorize ODD prime number product n=F1*F2
//
declare F1:(isize(n)-1);
declare F2:(isize(n)-1);
declare X:(isize(n)-1);
declare Y:(isize(n)-1);
declare A:(2*(isize(n)-2));
declare B:(2*(isize(n)-2));

order Y,X,A,B,-occur;

[A k=isize(n)-3]
(
(n + B == A) &&
[A i=k..0] (X[i] == (({false[0:(i-1)],1,X[(i+1):k]} *
                      {false[0:(i-1)],1,X[(i+1):k]} <= A))) &&
(X*X == A) && (X > 0) &&

[A i=k..0] (Y[i] == (({false[0:(i-1)],1,Y[(i+1):k]} *
                      {false[0:(i-1)],1,Y[(i+1):k]} <= B))) &&
(Y*Y == B) && (Y > 0) &&

(X > Y) && 

(F1 == (X+Y)) &&
(F2 == (X-Y)) &&
(F1 > 1) && (F2 > 1)
)
