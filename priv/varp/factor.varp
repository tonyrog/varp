//
// Factorize prime number product n=F1*F2 where F1 and F2 are odd
// (2a+1)(2b+1) = 4ab + 2a +2b + 1  (n must be odd)
// smallest n is a=1, b=1 => n=3*3=9  but f1 != f2
// a=1, b=2 => n=3*5 = 15!
//
assert (n & 1) == 1;
assert sqr(isqrt(n)) != n;
assert n>=15;

declare F1:(isize(n)-1);
declare F2:(isize(n)-1);
declare X:(isize(n)-1);
declare Y:(isize(n)-1);
declare A:(2*(isize(n)-1));
declare B:(2*(isize(n)-1));

order Y,X,A,B,-occur;

[A k=isize(n)-3]
(
(n + B == A) &&
[A i=k..0] (X[i] == (({false[0:(i-1)],1,X[(i+1):k]} *
                      {false[0:(i-1)],1,X[(i+1):k]} <= A))) &&
(X*X == A) && (X > 0) &&

[A i=k..0] (Y[i] == (({false[0:(i-1)],1,Y[(i+1):k]} *
                      {false[0:(i-1)],1,Y[(i+1):k]} <= B))) &&
(Y*Y == B) && (Y > 0) &&

(X > Y) && 

(F1 == (X+Y)) &&
(F2 == (X-Y)) &&
(F1 > 1) && (F2 > 1)
)
