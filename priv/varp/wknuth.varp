//
// Knuth variant of warden(j, k, n)
//

[A m=n/(j-1),d=1..m,i=1..n-(j-1)*d] [E u=0..(j-1)] X(i+u*d) &&
[A m=n/(k-1),d=1..m,i=1..n-(k-1)*d] [E v=0..(k-1)] !X(i+v*d)


