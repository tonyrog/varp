//
//  Cube sum a^3+b^3 = c^3+d^3
//
declare A:((sz+2)/3);
declare B:((sz+2)/3);
declare C:((sz+2)/3);
declare D:((sz+2)/3);
declare A3:sz;
declare B3:sz;
declare C3:sz;
declare D3:sz;

declare Sum:(sz+1);

(Sum == A3 + B3) &&
(Sum == C3 + D3) &&

(A3 == A*A*A) &&
(B3 == B*B*B) &&
(C3 == C*C*C) &&
(D3 == D*D*D) &&

(A < B) &&
(C < D) &&
(A < C) && 

(A > 0) && 
(B > 0) &&
(C > 0) &&
(D > 0)

// sz=11
// solution 1729: 1^3 * 12^3 = 9^3 + 10^3