//
// Waerden formula
//  input is r = numer of colors  k = length of sequnce n = number of
//  buckets
//  rx is calculated as the number of bits needed to represent (r-1)
//  that is number 0..r-1
//

[E rx=trunc(log2(r-1))+1]
 ( ( ([A j=1..n] (F(j):rx <= (r-1) ) ) )
   ->
    ( [E g=0..((n-k)/(k-1)),i=0..(n-(g*k+k-g))]
       ( [A j=0..(k-2)] (F(i+(g+1)*j+1):rx == F(i+(g+1)*j+2):rx ) ) ) )





