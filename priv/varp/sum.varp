// how many sum over X1+..X9  = 45
// run as: varp satisfy -p true --carry=false < sum.varp

declare X1:7;
declare X2:7;
declare X3:7;
declare X4:7;
declare X5:7;
declare X6:7;
declare X7:7;
declare X8:7;
declare X9:7;
declare S:7;

(S == (X1 + X2 + X3 + X4 + X5 + X6 + X7 + X8 + X9)) &&
(S == 9) &&
(X1 >= 1) && (X1 <= 9) &&
(X2 >= 1) && (X2 <= 9) &&
(X3 >= 1) && (X3 <= 9) &&
(X4 >= 1) && (X4 <= 9) &&
(X5 >= 1) && (X5 <= 9) &&
(X6 >= 1) && (X6 <= 9) &&
(X7 >= 1) && (X7 <= 9) &&
(X8 >= 1) && (X8 <= 9) &&
(X9 >= 1) && (X9 <= 9)
