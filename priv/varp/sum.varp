// how many sum over X1+..X9  = 45
// run as: varp satisfy -p true --carry=false < sum.varp

(X1:6 + X2:6 + X3:6 + X4:6 + X5:6 + X6:6 + X7:6  + X8:6 + X9:6 == 45) &&
(X1:6 >= 1) && (X1:6 <= 9) &&
(X2:6 >= 1) && (X2:6 <= 9) &&
(X3:6 >= 1) && (X3:6 <= 9) &&
(X4:6 >= 1) && (X4:6 <= 9) &&
(X5:6 >= 1) && (X5:6 <= 9) &&
(X6:6 >= 1) && (X6:6 <= 9) &&
(X7:6 >= 1) && (X7:6 <= 9) &&
(X8:6 >= 1) && (X8:6 <= 9) &&
(X9:6 >= 1) && (X9:6 <= 9)
