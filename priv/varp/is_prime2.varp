// check if p (parameter) is prime
// (C*C - D*D = n, C>D)

declare A:(isize(n)-1);
declare B:((isize(n)+1)/2);
declare C:(isize(n)-1);
declare D:((isize(n)+1)/2);
declare E:(2*isize(n));
declare F:(isize(n)+1);
order D, -occur, C;

// A*B = n        E    F
// (c-d)(c+d) == c^2 - d^2 = n

(A == C-D) &&
(B == C+D) && 
(((C*C) == E) &&
 ((D*D) == F) &&
 ((E - F) == n) &&
 (C > D) )
