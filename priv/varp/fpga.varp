
#F0(i) := false ;
#F1(i) := not X(i) and not Y(i) ;
#F2(i) := not X(i) and Y(i) ;
#F3(i) := F1(i) or F2(i) ;
#F4(i) := X(i) and (not Y(i)) ;
#F5(i) := F1(i) or F4(i) ;
#F6(i) := X(i) xor Y(i) ;
#F7(i) := not (X(i) and Y(i)) ;
#F8(i) := X(i) and Y(i) ;
#F9(i) := F1(i) or F8(i) ;
#F10(i) := F2(i) or F8(i) ;
#F11(i) := F1(i) or F2(i) or F8(i) ;
#F12(i) := F4(i) or F8(i) ;
#F13(i) := F1(i) or F4(i) or F8(i) ;
#F14(i) := X(i) or Y(i) ;
#F15(i) := true ;

#FPGA(i) :=
	   ((F(i):4 == 0:4) && F0(i)) ||
	   ((F(i):4 == 1:4) && F1(i)) ||
	   ((F(i):4 == 2:4) && F2(i)) ||
	   ((F(i):4 == 3:4) && F3(i)) ||
	   ((F(i):4 == 4:4) && F4(i)) ||
	   ((F(i):4 == 5:4) && F5(i)) ||
	   ((F(i):4 == 6:4) && F6(i)) ||
	   ((F(i):4 == 7:4) && F7(i)) ||
	   ((F(i):4 == 8:4) && F8(i)) ||
	   ((F(i):4 == 9:4) && F9(i)) ||
	   ((F(i):4 == 10:4) && F10(i)) ||
	   ((F(i):4 == 11:4) && F11(i)) ||
	   ((F(i):4 == 12:4) && F12(i)) ||
	   ((F(i):4 == 13:4) && F13(i)) ||
	   ((F(i):4 == 14:4) && F14(i)) ||
	   ((F(i):4 == 15:4) && F15(i)) ;

