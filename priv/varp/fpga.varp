
// 3 bit fpga
define F0_3(i) (~X3(i) and ~X2(i) and ~X1(i)) ;
define F1_3(i) (~X3(i) and ~X2(i) and  X1(i)) ;
define F2_3(i) (~X3(i) and  X2(i) and ~X1(i)) ;
define F3_3(i) (~X3(i) and  X2(i) and  X1(i)) ;
define F4_3(i) ( X3(i) and ~X2(i) and ~X1(i)) ;
define F5_3(i) ( X3(i) and ~X2(i) and  X1(i)) ;
define F6_3(i) ( X3(i) and  X2(i) and ~X1(i)) ;
define F7_3(i) ( X3(i) and  X2(i) and  X1(i)) ;

define FPGA(i)
	   ((F(i):3 == 0) && F0_3(i))  ||
	   ((F(i):3 == 1) && F1_3(i))  ||
	   ((F(i):3 == 2) && F2_3(i))  ||
	   ((F(i):3 == 3) && F3_3(i))  ||
	   ((F(i):3 == 4) && F4_3(i))  ||
	   ((F(i):3 == 5) && F5_3(i))  ||
	   ((F(i):3 == 6) && F6_3(i))  ||
	   ((F(i):3 == 7) && F7_3(i)) ;

FPGA(1) && [EQ 1]{X1(1),X2(1),X3(1)}

