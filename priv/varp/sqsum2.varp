//
//  Square sum a^2+b^2 = c^2+d^2
// run with --carry=false
//

(Sum:(sz+1) == A:sz + B:sz) &&
(Sum:(sz+1) == C:sz + D:sz) &&

(A:sz == A0:((sz+1)/2)*A0:((sz+1)/2)) &&
(B:sz == B0:((sz+1)/2)*B0:((sz+1)/2)) &&
(C:sz == C0:((sz+1)/2)*C0:((sz+1)/2)) &&
(D:sz == D0:((sz+1)/2)*D0:((sz+1)/2)) &&

(A:sz < B:sz) && (A:sz < C:sz) && (A:sz != D:sz) && 
(B:sz != C:sz) && (B:sz != D:sz) && 
(C:sz < D:sz) &&

(A:sz != 0) && 
(B:sz != 0) &&
(C:sz != 0) &&
(D:sz != 0)

