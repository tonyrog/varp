// Integer version of sudoku encoding
declare S(i,j):4;  // each position is 4 bit (BCD)

[A i=1..9,j=1..9] (S(i,j) > 0) &&
[A i=1..9,j=1..9] (S(i,j) < 10) &&
[A i=1..9,j=1..8,k=(j+1)..9] (S(i,j) != S(i,k)) &&
[A i=1..9,j=1..8,k=(j+1)..9] (S(j,i) != S(k,i)) &&
[A i=0..8,j=0..7,k=(j+1)..8]
( S((i/3)*3+(j/3)+1,(i%3)*3+(j%3)+1) !=
  S((i/3)*3+(k/3)+1,(i%3)*3+(k%3)+1) )
