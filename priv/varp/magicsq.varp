//
// All elements must be squre numbers
// run --carry=false
// 


(A:sz == _A11:((sz+1)/2)*_A11:((sz+1)/2)) &&
(B:sz == _A12:((sz+1)/2)*_A12:((sz+1)/2)) &&
(C:sz == _A13:((sz+1)/2)*_A13:((sz+1)/2)) &&

(D:sz == _A21:((sz+1)/2)*_A21:((sz+1)/2)) &&
(E:sz == _A22:((sz+1)/2)*_A22:((sz+1)/2)) &&
(F:sz == _A23:((sz+1)/2)*_A23:((sz+1)/2)) &&

(G:sz == _A31:((sz+1)/2)*_A31:((sz+1)/2)) &&
(H:sz == _A32:((sz+1)/2)*_A32:((sz+1)/2)) &&
(I:sz == _A33:((sz+1)/2)*_A33:((sz+1)/2)) &&

//
// All elements must be distinct
//
(A:sz != B:sz) && (A:sz != C:sz) && 
(A:sz != D:sz) && (A:sz != E:sz) && (A:sz != F:sz) &&
(A:sz != G:sz) && (A:sz != H:sz) && (A:sz != I:sz) &&
(B:sz != C:sz) &&
(B:sz != D:sz) && (B:sz != E:sz) && (B:sz != F:sz) &&
(B:sz != G:sz) && (B:sz != H:sz) && (B:sz != I:sz) &&
(C:sz != D:sz) && (C:sz != E:sz) && (C:sz != F:sz) &&
(C:sz != G:sz) && (C:sz != H:sz) && (C:sz != I:sz) &&
(D:sz != E:sz) && (D:sz != F:sz) &&
(D:sz != G:sz) && (D:sz != H:sz) && (D:sz != I:sz) &&
(E:sz != F:sz) &&
(E:sz != G:sz) && (E:sz != H:sz) && (E:sz != I:sz) &&
(G:sz != H:sz) && (G:sz != I:sz) &&
(H:sz != I:sz) &&

//
// All elements must be different from zero
//
(A:sz != 0) && (B:sz != 0) && (C:sz != 0) &&
(D:sz != 0) && (E:sz != 0) && (F:sz != 0) &&
(G:sz != 0) && (H:sz != 0) && (I:sz != 0) &&

// Row sums
(S:sz == A:sz + B:sz + C:sz) &&
(S:sz == D:sz + E:sz + F:sz) &&
(S:sz == G:sz + H:sz + I:sz) &&

// Column sums
(S:sz == A:sz + D:sz + G:sz) &&
(S:sz == B:sz + E:sz + H:sz) &&
(S:sz == C:sz + F:sz + I:sz) &&

// Diagonal sums
(S:sz == A:sz + E:sz + I:sz) &&
(S:sz == C:sz + E:sz + G:sz) &&

true

