// Pandiagonal magic sqaure
//  | A(0,0)  A(0,1)  A(0,2) A(0,3)
//  | A(1,0)  A(1,1)  A(1,2) A(1,3)
//  | A(2,0)  A(2,1)  A(2,2) A(2,3)
//  | A(3,0)  A(3,1)  A(3,2) A(3,3)
// 
declare A(i,j):6;
declare S:6;

(A(0,0) == 1) &&

// 1 <= A(i,j) <= 16
([A i=0..3, j=0..3] (A(i,j) >= 1))  &&
([A i=0..3, j=0..3] (A(i,j) <= 16)) && 

// Distinct elements
([A k=0..14][A l=(k+1)..15] (A(k/4,k%4) != A(l/4,l%4))) &&

// Row sums (4)
([A i=0..3] (S == [SUM j=0..3]A(i,j))) &&

// Column sums (4)
([A j=0..3] (S == [SUM i=0..3]A(i,j))) &&

// Diagonal sums (2)
(S == [SUM i=0..3]A(i,i)) &&
(S == [SUM i=0..3]A(i,3-i)) &&

// Split Diagonal sums (2)
(S == A(0,1)+A(1,0)+A(2,3)+A(3,2)) &&
(S == A(0,2)+A(1,3)+A(2,0)+A(3,1)) &&

// 2x2 squares (16)
([ALL i=0..3, j=0..3]
     (S == A(i,j)+A(i,(j+1)%4)+A((i+1)%4,j)+A((i+1)%4,(j+1)%4))) &&

// 3x3 square (4)
([ALL i=0..1, j=0..1]
     (S == A(i,j)+A(i,(j+2)%4)+A((i+2)%4,j)+A((i+2)%4,(j+2)%4))) &&

// Horizontal adjacent + (2,2) offset (8)
([ALL i=0..3, j=0..1]
     (S == A(i,j)+A(i,(j+1)%4)+
           A((i+2)%4,(j+2)%4)+A((i+2)%4,(j+3)%4))) &&

// Vertical adjacent + (2,2) offset (8)
([ALL i=0..3, j=0..1]
     (S == A(i,j)+A((i+1)%4,j)+
           A((i+2)%4,(j+2)%4)+A((i+3)%4,(j+2)%4))) &&

// Diagonal+corner (4)
(S == A(0,0)+A(1,3)+A(2,2)+A(3,1)) &&
(S == A(1,0)+A(2,1)+A(3,2)+A(0,3)) &&
(S == A(3,0)+A(0,1)+A(1,2)+A(2,3)) &&
(S == A(3,3)+A(2,0)+A(1,1)+A(0,2)) &&

// 4+4+2+2+16+4+8+8+4 = 52

true
