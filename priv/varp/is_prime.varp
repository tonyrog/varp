// Check if p (parameter) is prime
//
// example:
// 8 bit:
//   241 * 211 = 50851
// 10 bit:
//   1117 * 1123 = 1254391
// 11 bit:
//   2053 * 2063 = 4235339
// 12 bit:
//   4099 * 4111 = 16850989
// 16 bit:
//    41269 * 53927 = 2225513363
// 20 bit
//    674717 * 611147 = 412351270399
//
declare A:(isize(p)-1);
declare B:((isize(p)+1)/2);
order B, -occur, A;

((A * B) == p) && (A > B) && (B > 1)

