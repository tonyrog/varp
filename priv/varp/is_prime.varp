// Check if n (parameter) is prime
//
// BIT   A * B = VALUE                    EVAL    ADDED   TIME
// 8  :  241 * 211     = 50851            149     64      0.1
// 10 : 1117 * 1123    = 1254391          1295    630     1.6
// 11 : 2053 * 2063    = 4235339          3552    1653    5.4
// 12 : 4099 * 4111    = 16850989         4336    2074    7.4
// 13 : 8209 * 8219    = 67469771         13210   6488    22.3
// 14 : 16411 * 16417  = 269419387        9696    4753    24.5
// 15 : 32771 * 32779  = 1074200609       33511   16417   96.9
// 16 : 41269 * 53927  = 2225513363       42924   21352   138.8
// 17 : 131101 * 131111 = 17188783211
// 18 : 262147 * 262151 = 68722098197
// 19 : 524309* 524341  = 274916705369
// 20 : 674717 * 611147 = 412351270399
//
declare A:(isize(n)-1);
declare B:((isize(n)+1)/2);
order B, -occur, A;

((A * B) == n) && (A > B) && (B > 1)

