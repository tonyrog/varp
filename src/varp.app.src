{application, varp,
 [{description, "VARP"},
  {vsn, git},
  {registered, []},
  {env, [
	 {plugins, [
		    {"satisfy", varp_satisfy},
		    {"prove", varp_prove},
		    {"order", varp_order},
		    {"bt", varp_backtrack},
		    {"bj", varp_backjump},
		    {"sat", varp_saturate},
		    {"red", varp_reduction},
		    {"rat", varp_rat},
		    {"dump", varp_dump}
		   ]}
	 ]},
  {applications,[kernel,stdlib]}
  ]}.
