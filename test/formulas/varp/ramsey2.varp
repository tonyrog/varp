//
// Ramsey formula ( the negation of it )
//
//  Find a graph G of size n such that there
//  is no clique of size k and no independent set of size m
//
//  E([i,j]) is true if there is an edge between vertex i and j
//  A clique of size 3 is then expressed like 
//  E([1,2]) & E([1,3]) & E([2,3])
//  k=3 m=3 n=6
//  k=3 m=4 n=9
//  k=4 m=3 n=9
//  k=4 m=4 n>17
//  k=5 m=5 n>21
//
declare E(i):2

// there is no k-clique colored with color=0
[ A i=subsets(k, 1..n) ] ![A j=subsets(2,i)] (E(j)==0)

and

// there is no m-clique colored with color=1
[ A i=subsets(m, 1..n) ] ![A j=subsets(2,i)] (E(j)==1)
