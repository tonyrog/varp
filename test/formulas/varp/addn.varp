// An n bit adder generated from full adders with a quantified
// assignment: "[A i=0..n-1] s[i] = fa(...);" is the statement for
// every index, with the bits of the vectors as arguments, the carry
// chain RC as a vector of n+1 bits, and the out argument RC[i+1]
// wired to the next full adder.
//
//     varp sat bj --max 0 n=3 formulas/varp/addn.varp
//
// asks which A > B add up to 6 in three bits: (4,2), (5,1), (6,0).

circuit ha(in a, b; out s, co)
{
    s  = a ^ b;
    co = a & b;
}

circuit fa(in a, b, ci; return s; out co)
{
    s  = a ^ b ^ ci;
    co = (a & b) || (ci & (a ^ b));
}

circuit addn(in a:n, b:n, ci; return s:n; out co)
{
    declare RC:(n+1);
    RC[0] = ci;
    [A i=0..n-1]
        s[i] = fa(a[i], b[i], RC[i], RC[i+1]);
    co = RC[n];
}

declare A:3, B:3;

(addn(A, B, 0, Co) == 6) && (A > B)
