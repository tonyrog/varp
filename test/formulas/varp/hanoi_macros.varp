// Towers of hanoi with the system macros: n discs, three pegs, a peg
// is a stack Tower(p, 1..n), top first, 0 is an empty cell
system hanoi {
    state Tower(p,y,time):(usize(n+1));
    input Move(p,q,time);

    define can(a,b)   (Tower(a,1) > 0) && (Tower(b,n) == 0) &&
                      ((Tower(b,1) == 0) || (Tower(a,1) < Tower(b,1)));
    define pop(a)     ([A i=1..n-1] ('Tower(a,i) == Tower(a,i+1))) && ('Tower(a,n) == 0);
    define push(b,d)  ([A i=2..n] ('Tower(b,i) == Tower(b,i-1))) && ('Tower(b,1) == d);
    define keep(c)    [A i=1..n] ('Tower(c,i) == Tower(c,i));

    init   [A y=1..n] (Tower(1, y) == y);
    init   [A p=2..3, y=1..n] (Tower(p, y) == 0);
    assume [E! p=1..3, q=1..3, p != q] Move(p,q);

    next [A a=1..3, b=1..3, c=1..3, a != b, b != c, a != c]
         (Move(a,b) -> can(a,b) && pop(a) && push(b, Tower(a,1)) && keep(c));

    reach [A y=1..n] (Tower(3, y) == y);
}
