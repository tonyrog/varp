%% -*- erlang -*-
%% pento_epx configuration: the pieces, the puzzles and the solver recipe.
%%
%% {cell, Pixels}            board cell size on screen (shrunk for big boards)
%% {board_px, Pixels}        the square the board is fitted into
%% {solve, "plugins ..."}    the plugin chain pento_epx runs on Solve,
%%                           same syntax as the varp command line
%% {piece, Id, Name, Color, Shape}
%%                           Shape is rows of S (dark square), V (light
%%                           square) and . (empty).  Id numbers P(Id,...)
%%                           and L(Id,...) in the generated formula.
%% {puzzle, Name, Options, Rows}
%%                           Rows are strings, # is a cell of the figure,
%%                           anything else is outside.  Options:
%%                             colored          the chess board: a piece's
%%                                              S cells must sit on dark
%%                                              squares (top left is dark)
%%                             {pieces, all}    every piece, each once
%%                             {pieces, {except, [Name]}}
%%                             {pieces, [Name]} these pieces, each once
%%                             {pieces, any}    any pieces, each at most once
%%
%% The pentominoes carry the letter names from Golomb (F I L N P T U V W
%% X Y Z); A is the 2x2 square of the pento chess set.

{cell, 44}.
{board_px, 440}.
{solve, "sat saturate -k=1 --timeout=15 bj --timeout=120 --max-learned=100000 --restart-interval=3 --minimize=local"}.

{piece,  1, "A", {205,205,205}, ["VS",
                                 "SV"]}.
{piece,  2, "X", {230, 80, 80}, [".V.",
                                 "VSV",
                                 ".V."]}.
{piece,  3, "L", { 80,160,230}, ["SV",
                                 "V.",
                                 "S.",
                                 "V."]}.
{piece,  4, "I", { 80,190,100}, ["S",
                                 "V",
                                 "S",
                                 "V",
                                 "S"]}.
{piece,  5, "U", {240,200, 60}, ["VS",
                                 "S.",
                                 "VS"]}.
{piece,  6, "Y", {230,140, 60}, ["V.",
                                 "SV",
                                 "V.",
                                 "S."]}.
{piece,  7, "T", {160, 90,200}, ["SVS",
                                 ".S.",
                                 ".V."]}.
{piece,  8, "N", { 60,190,190}, ["S.",
                                 "VS",
                                 ".V",
                                 ".S"]}.
{piece,  9, "Z", {230,110,170}, [".SV",
                                 ".V.",
                                 "VS."]}.
{piece, 10, "V", {150,110, 70}, ["V..",
                                 "S..",
                                 "VSV"]}.
{piece, 11, "W", {120,200, 60}, ["S..",
                                 "VS.",
                                 ".VS"]}.
{piece, 12, "P", { 90,110,230}, ["VS",
                                 "SV",
                                 ".S"]}.
{piece, 13, "F", {200,180,140}, [".SV",
                                 "SV.",
                                 ".S."]}.

%% the pento chess puzzle: all 13 pieces on the chess board, colours
%% matching (what pento.erl generates as pento.varp)
{puzzle, "Pento chess 8 x 8", [colored, {pieces, all}],
 ["########",
  "########",
  "########",
  "########",
  "########",
  "########",
  "########",
  "########"]}.

%% the classic rectangles, all twelve pentominoes
{puzzle, "6 x 10", [{pieces, {except, ["A"]}}],
 ["##########",
  "##########",
  "##########",
  "##########",
  "##########",
  "##########"]}.

{puzzle, "5 x 12", [{pieces, {except, ["A"]}}],
 ["############",
  "############",
  "############",
  "############",
  "############"]}.

{puzzle, "4 x 15", [{pieces, {except, ["A"]}}],
 ["###############",
  "###############",
  "###############",
  "###############"]}.

{puzzle, "3 x 20", [{pieces, {except, ["A"]}}],
 ["####################",
  "####################",
  "####################"]}.

{puzzle, "8 x 8 with a hole", [{pieces, {except, ["A"]}}],
 ["########",
  "########",
  "########",
  "###..###",
  "###..###",
  "########",
  "########",
  "########"]}.

%% smaller figures: pick any pieces that fit
{puzzle, "3 x 5", [{pieces, any}],
 ["#####",
  "#####",
  "#####"]}.

{puzzle, "4 x 5", [{pieces, any}],
 ["#####",
  "#####",
  "#####",
  "#####"]}.

{puzzle, "5 x 5", [{pieces, any}],
 ["#####",
  "#####",
  "#####",
  "#####",
  "#####"]}.

{puzzle, "Volcano", [{pieces, any}],
 ["....#....",
  "...###...",
  "..#####..",
  ".#######.",
  "#########"]}.

{puzzle, "Cross", [{pieces, any}],
 ["...###...",
  "...###...",
  "...###...",
  "#########",
  "#########",
  "#########",
  "...###...",
  "...###...",
  "...###..."]}.

{puzzle, "Broken rectangle", [{pieces, any}],
 ["#######",
  "#######",
  "#######",
  "#######",
  "#######",
  "#####..",
  "#####.."]}.
