// a * b + c in float754 (e, m) with one rounding, IEEE with subnormals
// (z flushes tiny results to zero, --ftz).  The exact product sits in a
// window of w = 3m+8 bits at bit 3; c's significand starts at the top
// (lsb at 2m+7, clear of the product) and is shifted right by
// r = m+4 + Ea + Eb - Ec - bias with a sticky bit in bit 0; r < 0
// leaves it there and raises the window's base by -r.  Signs equal:
// add; else the smaller from the larger, the sign follows the larger
// and an exact difference is +0.  Then op_fnorm and op_fpack.
circuit op_ffma(meta e, m, z; in a:(1+e+m), b:(1+e+m), c:(1+e+m);
                return r:(1+e+m); out over, under, nan)
{
    declare SA, SB, SC, SP, HA, HB, HC, EA0:e, EB0:e, EC0:e, EA:e, EB:e, EC:e;
    declare P:(2*m+2), PW:(3*m+8), R1:(e+1), RR:(e+3)/signed, RNEG, RBIG;
    declare AMT:(usize(3*m+8)), CTOP:(3*m+8), CS:(3*m+8), STC, CW:(3*m+8);
    declare SUB, TOT:(3*m+9), PGEC, D1:(3*m+8), D2:(3*m+8), DIF:(3*m+8), RES:(3*m+9);
    declare Z1, RN:(3*m+9), LZ:(ilog2(3*m+8)+1), NEGR:(e+3)/signed, EXTRA:(e+3)/signed;
    declare EX:(e+4)/signed, S0, S1, ZEROSUB, S2, S, SINF;
    declare ZA, IA, NA, ZB, IB, NB, ZC, IC, NC, IP, INFC0, MASKED, MAG:(e+m), ZERO, INFC;
    SA = a[e+m];
    SB = b[e+m];
    SC = c[e+m];
    SP = SA ^ SB;
    [A i=0..(e-1)] EA0[i] = a[m+i];
    [A i=0..(e-1)] EB0[i] = b[m+i];
    [A i=0..(e-1)] EC0[i] = c[m+i];
    HA = (EA0 != 0);
    HB = (EB0 != 0);
    HC = (EC0 != 0);
    EA[0] = EA0[0] | !HA;
    [A i=1..(e-1)] EA[i] = EA0[i];
    EB[0] = EB0[0] | !HB;
    [A i=1..(e-1)] EB[i] = EB0[i];
    EC[0] = EC0[0] | !HC;
    [A i=1..(e-1)] EC[i] = EC0[i];
    // the product in the window at bit 3
    declare SIGA:(m+1), SIGB:(m+1);
    [A i=0..(m-1)] SIGA[i] = a[i];
    SIGA[m] = HA;
    [A i=0..(m-1)] SIGB[i] = b[i];
    SIGB[m] = HB;
    P = SIGA * SIGB;
    [A i=0..(3*m+7)] PW[i] = P[i-3];
    // the addend from the top, shifted right by r clamped to [0, w]
    R1 = EA + EB;
    RR = R1 - EC + (m+4 - ((1<<(e-1))-1));
    RNEG = (RR < 0);
    RBIG = (RR >= 3*m+8);
    [A i=0..(usize(3*m+8)-1)] AMT[i] = !RNEG & (RBIG | RR[i]);
    [A i=0..(2*m+6)] CTOP[i] = false;
    [A i=0..(m-1)] CTOP[2*m+7+i] = c[i];
    CTOP[3*m+7] = HC;
    CS = CTOP >> AMT;
    STC = ((CS << AMT) != CTOP);
    CW[0] = CS[0] | STC;
    [A i=1..(3*m+7)] CW[i] = CS[i];
    // add, or the smaller from the larger
    SUB = SP ^ SC;
    TOT = PW + CW;
    PGEC = (PW >= CW);
    D1 = PW - CW;
    D2 = CW - PW;
    [A i=0..(3*m+7)] DIF[i] = PGEC ? D1[i] : D2[i];
    [A i=0..(3*m+8)] RES[i] = SUB ? DIF[i] : TOT[i];
    Z1 = (RES == 0);
    RN = op_fnorm(3*m+9, RES, LZ);
    // the biased exponent of the lead
    NEGR = 0 - RR;
    [A i=0..(e+2)] EXTRA[i] = RNEG & NEGR[i];
    EX = R1 + (m+5 - ((1<<(e-1))-1)) + EXTRA - LZ;
    // the sign
    S0 = PGEC ? SP : SC;
    S1 = SUB ? S0 : SP;
    ZEROSUB = Z1 & SUB;
    S2 = S1 & !ZEROSUB;
    // the special operands
    NA = op_fclass(e, m, a, ZA, IA);
    NB = op_fclass(e, m, b, ZB, IB);
    NC = op_fclass(e, m, c, ZC, IC);
    IP = IA | IB;
    nan = NA | NB | NC | (IA & ZB) | (IB & ZA) | (IP & IC & SUB);
    INFC0 = IP | IC;
    MASKED = nan | INFC0;
    SINF = IP ? SP : SC;
    S = INFC0 ? SINF : S2;
    MAG = op_fpack(e, m, z, RN, false, EX, Z1, MASKED, ZERO, over, under);
    INFC = over | INFC0;
    r = op_fresult(e, m, MAG, ZERO, INFC, nan, S);
}
