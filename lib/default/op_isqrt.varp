// floor(sqrt(a)) of 2k bits and the remainder a - q*q: restoring,
// two bits of a per step from the top; RS is the partial remainder
// shifted with the next pair, the root bit says whether 4q+1 fits
circuit op_isqrt(meta k; in a:(2*k); return q:k; out r:(k+3))
{
    declare R(i):(k+3), RS(i):(k+3), T(i):(k+3), Q(i):k, B(i);
    R(k) = 0;
    Q(k) = 0;
    [A i=0..(k-1)] T(i)[0] = true;
    [A i=0..(k-1)] T(i)[1] = false;
    [A i=0..(k-1)] [A j=2..(k+2)] T(i)[j] = Q(i+1)[j-2];
    [A i=0..(k-1)] RS(i)[0] = a[2*i];
    [A i=0..(k-1)] RS(i)[1] = a[2*i+1];
    [A i=0..(k-1)] [A j=2..(k+2)] RS(i)[j] = R(i+1)[j-2];
    [A i=0..(k-1)] B(i) = op_gte(RS(i), T(i));
    [A i=0..(k-1)] R(i) = B(i) ? op_sub(RS(i), T(i)) : RS(i);
    [A i=0..(k-1)] Q(i)[0] = B(i);
    [A i=0..(k-1)] [A j=1..(k-1)] Q(i)[j] = Q(i+1)[j-1];
    q = Q(0);
    r = R(0);
}
