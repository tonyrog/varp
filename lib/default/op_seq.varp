// a == b, signed: the narrower operand is sign extended before the
// bits are compared, so -1:3 == -1:5
circuit op_seq(in a:n/signed, b:m/signed; return q)
{
    declare A:(max(n,m)), B:(max(n,m));
    [A i=0..(max(n,m)-1), i<n]  A[i] = a[i];
    [A i=0..(max(n,m)-1), i>=n] A[i] = a[n-1];
    [A i=0..(max(n,m)-1), i<m]  B[i] = b[i];
    [A i=0..(max(n,m)-1), i>=m] B[i] = b[m-1];
    q = [A i=0..(max(n,m)-1)] (A[i] equ B[i]);
}
